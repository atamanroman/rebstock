{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rebstock Configuration",
  "type": "object",
  "properties": {
    "host": {
      "type": "string",
      "default": "127.0.0.1",
      "description": "IP to bind to (0.0.0.0 for all interfaces)"
    },
    "port": {
      "type": "integer",
      "default": 3000,
      "description": "HTTP server port"
    },
    "database_uri": {
      "type": "string",
      "default": "file:./data/rebstock.db",
      "description": "SQLite database URI"
    },
    "image_dir": {
      "type": "string",
      "default": "./data/images",
      "description": "Directory for wine bottle images"
    },
    "secret_key_base": {
      "type": "string",
      "description": "Secret key base for signed data. A random per-boot value is generated when unset."
    },
    "auth": {
      "type": "object",
      "description": "Authentication configuration. Exactly one of 'single' or 'forward' must be set.",
      "oneOf": [
        {
          "required": ["single"],
          "properties": {
            "single": {
              "type": "object",
              "description": "Single-user mode",
              "properties": {
                "user": {
                  "type": "string",
                  "default": "admin",
                  "description": "Username for single-user mode"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["forward"],
          "properties": {
            "forward": {
              "type": "object",
              "description": "Forward auth mode (e.g. Caddy forward_auth)",
              "properties": {
                "header_user": {
                  "type": "string",
                  "default": "x-webauth-user",
                  "description": "Header containing the username"
                },
                "header_name": {
                  "type": "string",
                  "default": "x-webauth-name",
                  "description": "Header containing the display name"
                },
                "header_email": {
                  "type": "string",
                  "default": "x-webauth-email",
                  "description": "Header containing the email"
                },
                "header_groups": {
                  "type": "string",
                  "default": "x-webauth-groups",
                  "description": "Header containing comma-separated groups"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "mcp": {
      "description": "Optional OAuth resource-server configuration for MCP; null or absent disables MCP.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "resource": {
              "type": "string",
              "format": "uri",
              "description": "Public MCP resource URL and required access-token audience."
            },
            "issuer": {
              "type": "string",
              "format": "uri",
              "description": "Exact access-token issuer from authorization-server discovery."
            },
            "jwks_uri": {
              "type": "string",
              "format": "uri",
              "description": "Fixed HTTPS issuer signing-key endpoint."
            },
            "client_id": {
              "type": "string",
              "minLength": 1,
              "description": "Allowed public OAuth client identifier."
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "description": "Required application-specific OAuth scope."
            },
            "username_claim": {
              "type": "string",
              "minLength": 1,
              "description": "Verified access-token claim identifying the Rebstock user."
            }
          },
          "required": [
            "resource",
            "issuer",
            "jwks_uri",
            "client_id",
            "scope",
            "username_claim"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["auth"],
  "additionalProperties": false
}
